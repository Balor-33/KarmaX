# backend/.env.example
#
# Copy this file to backend/.env for local development.
# backend/.env is gitignored — it must NEVER be committed.
#
# For Render deployment: set these as Environment Variables in the
# Render dashboard (Dashboard → Your Service → Environment).
# Do NOT upload a .env file to Render — use their env var UI.

# ── Gemini AI (REQUIRED) ────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase (optional – used for persistent AI response caching) ───
# Use the SERVICE ROLE key here (backend only, never Flutter).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Notes ────────────────────────────────────────────────────────────
# SUPABASE_ANON_KEY goes in Flutter (--dart-define), NOT here.
# GEMINI_API_KEY must NEVER appear in any Flutter file.

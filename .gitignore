.pub-cache/
.pub/
/build/
/coverage/

# ── Secret / credential files ─────────────────────────────────────────────────
# NEVER commit real API keys. The rules below block all .env variants.
#
# What goes where:
#   GEMINI_API_KEY        → Render env var (backend only) OR backend/.env (local dev)
#   SUPABASE_SERVICE_ROLE → Render env var (backend only) OR backend/.env (local dev)
#   SUPABASE_ANON_KEY     → --dart-define at flutter build/run time
#   SUPABASE_URL          → --dart-define at flutter build/run time
#
# Gitignored env files (real secrets):
.env
.env.local
.env.production
.env.staging
assets/.env
assets/.env.local
backend/.env
backend/.env.local
# Generic pattern (catch any subdirectory)
**/.env
**/.env.local

# Allowed: example/template files (no real values)
!.env.example
!assets/.env.example
!backend/.env.example

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
